<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Search Bar - Native-like UI -->
    <t t-name="sm_x2many_search.SearchBar">
        <div class="x2m-search-container" t-ref="container">
            <div class="x2m-search-bar">
                <!-- Filter Tags -->
                <t t-foreach="state.filters" t-as="filter" t-key="filter.id">
                    <span class="x2m-filter-tag">
                        <span class="filter-column" t-esc="filter.columnName"/>
                        <span class="filter-value" t-esc="filter.displayValue"/>
                        <button class="filter-remove" t-on-click="() => this.removeFilter(filter.id)" type="button">×</button>
                    </span>
                </t>

                <!-- Search Input -->
                <input type="text"
                       class="x2m-search-input"
                       t-ref="searchInput"
                       t-att-value="state.query"
                       t-on-focus="onFocus"
                       t-on-input="onInput"
                       t-on-keydown="onKeydown"
                       placeholder="Search..."
                />

                <!-- Row Count Badge -->
                <span class="x2m-row-count" t-if="state.filters.length">
                    <t t-esc="visibleCount"/>/<t t-esc="totalRowsCount"/> Rows
                </span>
            </div>

            <!-- Dropdown Suggestions -->
            <div class="x2m-dropdown" t-if="state.showDropdown and state.suggestions.length">
                <t t-foreach="state.suggestions" t-as="suggestion" t-key="suggestion_index">
                    <!-- Main suggestion item -->
                    <div class="x2m-suggestion-row">
                        <!-- Expand arrow for sub-options -->
                        <span class="suggestion-expand" 
                              t-if="suggestion.hasSubOptions"
                              t-on-click.stop="() => this.toggleExpand(suggestion.column?.name)">
                            <i t-att-class="state.expandedColumn === suggestion.column?.name ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                        </span>
                        <span class="suggestion-expand-placeholder" t-else=""/>

                        <!-- Main clickable area -->
                        <div class="suggestion-main" t-on-click="() => this.selectSuggestion(suggestion)">
                            <span class="suggestion-label" t-esc="suggestion.label"/>
                            <span class="suggestion-query" t-esc="suggestion.query"/>
                        </div>
                    </div>

                    <!-- Sub-options (expanded) -->
                    <t t-if="state.expandedColumn === suggestion.column?.name and suggestion.subOptions">
                        <t t-foreach="suggestion.subOptions" t-as="subOption" t-key="subOption_index">
                            <div class="x2m-suboption-row" t-on-click="() => this.selectSuggestion(suggestion, subOption)">
                                <span class="suboption-indent"/>
                                <span class="suboption-label" t-esc="subOption.label"/>
                            </div>
                        </t>
                    </t>
                </t>
            </div>
        </div>
    </t>

    <!-- One2Many Search Field -->
    <t t-name="sm_x2many_search.One2ManySearchField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="before">
            <X2ManySearchBar 
                columns="searchableColumns"
                records="searchableRecords"
                onSearch.bind="onSearchFilter"
                onClear.bind="onClearFilter"
                keyStore="'x2m'"
                placeholder="'Search...'"
                hiddenCount="searchState.hiddenCount"
            />
        </xpath>
    </t>

    <!-- Many2Many Search Field -->
    <t t-name="sm_x2many_search.Many2ManySearchField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="before">
            <X2ManySearchBar 
                columns="searchableColumns"
                records="searchableRecords"
                onSearch.bind="onSearchFilter"
                onClear.bind="onClearFilter"
                keyStore="'x2m'"
                placeholder="'Search...'"
                hiddenCount="searchState.hiddenCount"
            />
        </xpath>
    </t>

    <!-- Section and Note Search Field (Invoice Lines, Sale Order Lines, etc.) -->
    <t t-name="sm_x2many_search.SectionAndNoteSearchField" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_x2m_control_panel')]" position="before">
            <X2ManySearchBar 
                columns="searchableColumns"
                records="searchableRecords"
                onSearch.bind="onSearchFilter"
                onClear.bind="onClearFilter"
                keyStore="'section_note'"
                placeholder="'Search lines...'"
                hiddenCount="searchState.hiddenCount"
            />
        </xpath>
    </t>

</templates>
